  publishedAt        DateTime?
  sourceSnapshotDays Int      @default(0)
  sourceRunIds       Json?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([companyId, monthStart])
  @@index([companyId, monthStart(sort: Desc)])
  @@index([companyId, status, monthStart(sort: Desc)])
}

model DailyFinancialMappedLine {
  id                String   @id @default(cuid())
  companyId         String
  snapshotDate      DateTime
  frequency         String   @default("daily")
  sourceAccountName String
  sourceAccountId   String?
  sourceAccountType String?
  targetField       String
  amount            Float    @default(0)
  sourcePlatform    String?  @default("SCHEDULED_INTEGRATION")
  sourceRunId       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([companyId, snapshotDate(sort: Desc)])
  @@index([companyId, frequency, snapshotDate(sort: Desc)])
  @@index([companyId, targetField, snapshotDate(sort: Desc)])
  @@index([companyId, sourceRunId])
  @@index([companyId, sourceAccountName])
  @@unique([companyId, snapshotDate, frequency, sourceAccountName, targetField])
}

// One-time-known balance-sheet anchor for a company, sourced from a trusted
// external balance sheet (e.g. Infor M3 BS run for 12/31 of a fiscal year).
// Used by the daily-bs-from-gl rebuilder as a starting point: for any
// snapshotDate >= anchorDate, each balance-sheet line is computed as
// `anchor[field] + GL_delta(field, anchorDate < transDate <= snapshotDate)`
// instead of summing GL from the beginning of time. This avoids historical
// GL drift from incomplete loads or pre-system carryover entries.
//
// Multiple anchors per company are allowed (one per anchorDate); the rebuild
// picks the most recent anchor with anchorDate <= snapshotDate.
model BalanceSheetAnchor {
  id                      String   @id @default(cuid())
  companyId               String
  anchorDate              DateTime // EOD balance-sheet date (UTC midnight)

  cash                    Float    @default(0)
  ar                      Float    @default(0)
  retainageReceivables    Float    @default(0)
  contractAssets          Float    @default(0)
  inventory               Float    @default(0)
  otherCA                 Float    @default(0)
  fixedAssets             Float    @default(0)
  constructionEquipment   Float    @default(0)
  officeEquipment         Float    @default(0)
  shopEquipment           Float    @default(0)
  investments             Float    @default(0)
  rightOfUseLeases        Float    @default(0)
  otherAssets             Float    @default(0)
  ap                      Float    @default(0)
  loc                     Float    @default(0)
  contractLiabilities     Float    @default(0)
  otherCL                 Float    @default(0)
  ltd                     Float    @default(0)
  ownersCapital           Float    @default(0)
  ownersDraw              Float    @default(0)
  commonStock             Float    @default(0)
  preferredStock          Float    @default(0)
  retainedEarnings        Float    @default(0)
  additionalPaidInCapital Float    @default(0)
  treasuryStock           Float    @default(0)

  source                  String?  // free-form provenance (e.g. "INFOR_M3_BS_2023-12-31")
  notes                   String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([companyId, anchorDate])
  @@index([companyId, anchorDate(sort: Desc)])
}

// Per-account opening balance at a trusted external anchor date.
// Companion to BalanceSheetAnchor (which only stores rollups). Each row
// records the GL-signed opening balance for a single account so per-account
// reports (Account Review, future drilldowns) can render
// `openingBalance + GL_delta(this account, anchor < transDate <= asOf)`
// instead of summing GL from time zero (which omits pre-ingest activity).
//
// Sign convention: GL-signed. Debits positive, credits negative. So a Cash
// account opening at $50,000 debit balance is stored as +50000; an AP
// account opening at $700,000 credit balance is stored as -700000; an
// Accumulated Depreciation account opening at $10,000 credit is stored as
// -10000. The display layer reads the sign to decide whether to render
// "(CR)".
//
// Multiple anchor dates per company are allowed; consumers pick the most
// recent anchorDate <= asOfDate.
model BalanceSheetAccountAnchor {
  id              String   @id @default(cuid())
  companyId       String
  anchorDate      DateTime // EOD balance-sheet date (UTC midnight)
  accountId       String   // GL accountId as it appears in GLTransactionFact
  accountName     String?  // human label captured at anchor time
  accountCode     String?  // optional secondary identifier
  openingBalance  Float    @default(0) // GL-signed (debit positive, credit negative)

  source          String?  // provenance label (e.g. "INFOR_M3_TB_2023-12-31")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([companyId, anchorDate, accountId])
  @@index([companyId, anchorDate(sort: Desc)])
  @@index([companyId, accountId])
}

// Cached daily EOD FX rates (shared across companies; not per-tenant).
// Rate dates follow America/New_York calendar days for EST EOD jobs.
model FxRate {
  id               String    @id @default(cuid())
  provider         String    // e.g. frankfurter
  fromCurrency     String    // ISO 4217
  toCurrency       String    // ISO 4217
  rateDate         DateTime  // UTC midnight for the EST calendar date
  rate             Float     // multiplier: amount_to = amount_from * rate
  rateType         String    @default("daily_eod")
  isFallback       Boolean   @default(false)
  fallbackFromDate DateTime?
  retrievedAt      DateTime  @default(now())
  sourceTimestamp  DateTime?
  createdAt        DateTime  @default(now())

  @@unique([provider, fromCurrency, toCurrency, rateDate, rateType])
  @@index([fromCurrency, toCurrency, rateDate])
}