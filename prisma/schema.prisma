  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  lobAllocations        Json?
  // Per-account owner ownership share (0-100). Used by Account Review to
  // compute "Owner Amount" = Latest Value * ownerPercent / 100.
  ownerPercent          Float?
  // Bucket assignment for the SDE/EBITDA Adjustments page. Null = not an
  // SDE adjustment. Allowed values:
  //   OWNER_COMP, PERSONAL, NON_RECURRING, ONE_TIME_REVENUE
