// Daily transaction data from Xero for operational reports
model XeroTransaction {
  id              String   @id @default(cuid())
  companyId       String
  transactionId   String   // Xero's invoice/bill/transaction ID
  transactionType String   // INVOICE, BILL, BANK_TRANSACTION, PAYMENT
  date            DateTime
  dueDate         DateTime?
  contact         String?  // Customer/Supplier name
  reference       String?  // Invoice/Bill number
  total           Float    @default(0)
  amountPaid      Float    @default(0)
  amountDue       Float    @default(0)
  status          String?  // DRAFT, SUBMITTED, AUTHORISED, PAID, etc.
  lineItems       Json?    // Array of line items with account details
  rawData         Json?    // Full Xero transaction object
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, transactionId])
  @@index([companyId])
  @@index([date])
  @@index([transactionType])
}

model SystemSettings {
  id                       String   @id @default(cuid())
  key                      String   @unique
  businessMonthlyPrice     Float?   @default(0)
  businessQuarterlyPrice   Float?   @default(0)
  businessAnnualPrice      Float?   @default(0)
  consultantMonthlyPrice   Float?   @default(0)
  consultantQuarterlyPrice Float?   @default(0)
  consultantAnnualPrice    Float?   @default(0)
  updatedAt                DateTime @updatedAt
  createdAt                DateTime @default(now())

  @@index([key])
}

model Affiliate {
  id           String          @id @default(cuid())
  name         String          @unique
  contactName  String?
  contactEmail String?
  contactPhone String?
  address      String?
  city         String?
  state        String?
  zip          String?
  website      String?
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  codes        AffiliateCode[]
  companies    Company[]

  @@index([name])
}

model AffiliateCode {
  id             String    @id @default(cuid())
  affiliateId    String
  code           String    @unique
  description    String?
  isActive       Boolean   @default(true)
  expiresAt      DateTime?
  maxUses        Int?
  currentUses    Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  annualPrice    Float     @default(0)
  monthlyPrice   Float     @default(0)
  quarterlyPrice Float     @default(0)
  affiliate      Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
  @@index([code])
}

model Subscription {
  id                 String               @id @default(cuid())
  companyId          String               @unique
  usaepayCustomerId  String?
  usaepayBillingId   String?
  plan               String
  amount             Float
  status             SubscriptionStatus   @default(PENDING)
  nextBillingDate    DateTime?
  lastPaymentDate    DateTime?
  billingStartDate   DateTime?
  billingEndDate     DateTime?
  cardLast4          String?
  cardType           String?
  cardExpMonth       String?
  cardExpYear        String?
  failedPaymentCount Int                  @default(0)
  lastFailureReason  String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  transactions       PaymentTransaction[]
  company            Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status])
  @@index([nextBillingDate])
}

model PaymentTransaction {
  id             String        @id @default(cuid())
  subscriptionId String?
  companyId      String
  amount         Float
  status         PaymentStatus
  type           PaymentType
  transactionId  String?
  authCode       String?
  cardLast4      String?
  cardType       String?
  errorMessage   String?
  errorCode      String?
  description    String?
  invoice        String?
  createdAt      DateTime      @default(now())
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId])
  @@index([companyId])
  @@index([status])
  @@index([createdAt])
}

model RevenueRecord {
  id                    String   @id @default(cuid())
  transactionId         String   @unique // USAePay or payment processor transaction ID
  companyId             String
  consultantId          String?  // NULL if direct business (no consultant)
  amount                Float
  paymentDate           DateTime
  paymentStatus         String   @default("received") // 'received', 'failed', 'refunded', 'pending'
  subscriptionPlan      String   // 'monthly', 'quarterly', 'annual'
  billingPeriodStart    DateTime
  billingPeriodEnd      DateTime
  processorFee          Float?   // Payment processor fee (if tracked)
  netAmount             Float?   // Amount after processor fee
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  consultant            Consultant? @relation(fields: [consultantId], references: [id])

  @@index([companyId])
  @@index([consultantId])
  @@index([paymentStatus])
  @@index([paymentDate])
  @@index([billingPeriodStart])
}

model SubscriptionEvent {
  id            String   @id @default(cuid())
  companyId     String
  eventType     String   // 'created', 'plan_changed', 'price_changed', 'paused', 'cancelled', 'reactivated'
  previousValue String?
  newValue      String?
  notes         String?
  createdBy     String?  // User ID or email who made the change
  createdAt     DateTime @default(now())
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([eventType])
  @@index([createdAt])
}

model ConsultantPayable {
  id                     String   @id @default(cuid())
  consultantId           String
  periodStart            DateTime
  periodEnd              DateTime
  totalCompanyRevenue    Float    // Sum of all revenue from consultant's companies
  revenueSharePercentage Float    // Consultant's share % at time of calculation
  payableAmount          Float    // Amount owed to consultant (totalRevenue * share%)
  platformAmount         Float    // Amount kept by platform (totalRevenue * (100-share%))
  status                 String   @default("pending") // 'pending', 'paid', 'on_hold', 'cancelled'
  paidDate               DateTime?
  paymentMethod          String?  // How consultant was paid (check, ACH, wire, etc.)
  paymentReference       String?  // Check number, transaction ID, etc.
  notes                  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  consultant             Consultant @relation(fields: [consultantId], references: [id])

  @@index([consultantId])
  @@index([status])
  @@index([periodStart])
  @@index([paidDate])
}

enum UserRole {
  SITEADMIN
  CONSULTANT
  USER
}

enum UserType {
  COMPANY
  ASSESSMENT
}

enum BusinessStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum AccountingPlatform {
  QUICKBOOKS
  XERO
  SAGE
  NETSUITE
  DYNAMICS365
}

enum ConnectionStatus {
  ACTIVE
  INACTIVE
  ERROR
  EXPIRED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
  SUSPENDED
  PENDING
}

enum PaymentStatus {
  SUCCESS
  FAILED
  PENDING
  REFUNDED
}

enum PaymentType {
  INITIAL
  RECURRING
  MANUAL
  REFUND
}

model Loan {
  id            String      @id @default(cuid())
  companyId     String
  loanName      String
  loanIdNumber  String?
  lenderName    String
  loanAmount    Float
  interestRate  Float?
  termMonths    Int?
  startDate     DateTime
  endDate       DateTime?
  loanType      LoanType    @default(TERM)
  status        LoanStatus  @default(ACTIVE)
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  covenants     Covenant[]

  @@index([companyId])
  @@index([status])
}

model Covenant {
  id               String         @id @default(cuid())
  loanId           String
  covenantName     String
  covenantType     CovenantType   @default(MINIMUM)
  threshold        Float?
  currentValue     Float?
  status           CovenantStatus @default(COMPLIANT)
  description      String?
  isApplicable     Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  loan             Loan           @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId])
  @@index([status])
}

enum LoanType {
  TERM
  REVOLVER
  BRIDGE
  LINE_OF_CREDIT
  MORTGAGE
  OTHER
}

enum LoanStatus {
  ACTIVE
  MATURING
  PAID_OFF
  DEFAULTED
  INACTIVE
}

enum CovenantType {
  MINIMUM
  MAXIMUM
  RANGE
  QUALITATIVE
}

enum CovenantStatus {
  COMPLIANT
  WARNING
  BREACHED
  NOT_APPLICABLE
}

// ============================================================================
// OPERATIONAL DATA MODELS (QuickBooks Snapshots)
// ============================================================================

model CustomerSalesSnapshot {
  id             String   @id @default(cuid())
  companyId      String
  snapshotDate   DateTime // Changed from 'month' to support daily/weekly/monthly
  frequency      String   @default("monthly") // 'daily', 'weekly', 'monthly'
  customerId     String?  // QuickBooks customer ID
  customerName   String
  revenue        Float
  invoiceCount   Int
  avgInvoiceSize Float?
  createdAt      DateTime @default(now())
  
  @@index([companyId, snapshotDate(sort: Desc)])
  @@index([companyId, frequency, snapshotDate(sort: Desc)])
  @@index([companyId, customerId])
}

model ARAgingSnapshot {
  id           String   @id @default(cuid())
  companyId    String
  snapshotDate DateTime // Changed from 'month'
  frequency    String   @default("monthly") // 'daily', 'weekly', 'monthly'
  totalAR      Float
  current      Float    // 0-30 days
  days1to30    Float    // 31-60 days
  days31to60   Float    // 61-90 days
  days61to90   Float    // 91-120 days
  days90plus   Float    // 121+ days
  createdAt    DateTime @default(now())
  
  @@index([companyId, snapshotDate(sort: Desc)])
  @@index([companyId, frequency, snapshotDate(sort: Desc)])
  @@unique([companyId, snapshotDate, frequency])
}

model APAgingSnapshot {
  id           String   @id @default(cuid())
  companyId    String
  snapshotDate DateTime // Changed from 'month'
  frequency    String   @default("monthly") // 'daily', 'weekly', 'monthly'
  totalAP      Float
  current      Float    // 0-30 days
  days1to30    Float    // 31-60 days
  days31to60   Float    // 61-90 days
  days61to90   Float    // 91-120 days
  days90plus   Float    // 121+ days
  createdAt    DateTime @default(now())
  
  @@index([companyId, snapshotDate(sort: Desc)])
  @@index([companyId, frequency, snapshotDate(sort: Desc)])
  @@unique([companyId, snapshotDate, frequency])
}

model ProductSalesSnapshot {
  id              String   @id @default(cuid())
  companyId       String
  snapshotDate    DateTime // Changed from 'month'
  frequency       String   @default("monthly") // 'daily', 'weekly', 'monthly'
  itemId          String?  // QuickBooks item ID
  itemName        String
  sku             String?
  quantitySold    Float
  revenue         Float
  cogs            Float?
  grossMargin     Float?
  grossMarginPct  Float?
  createdAt       DateTime @default(now())
  
  @@index([companyId, snapshotDate(sort: Desc)])
  @@index([companyId, frequency, snapshotDate(sort: Desc)])
  @@index([companyId, itemId])
}

model InventorySnapshot {
  id           String   @id @default(cuid())
  companyId    String
  snapshotDate DateTime // Changed from 'month'
  frequency    String   @default("monthly") // 'daily', 'weekly', 'monthly'
  itemId       String?  // QuickBooks item ID
  itemName     String
  sku          String?
  qtyOnHand    Float
  assetValue   Float
  avgCost      Float?
  createdAt    DateTime @default(now())
  
  @@index([companyId, snapshotDate(sort: Desc)])
  @@index([companyId, frequency, snapshotDate(sort: Desc)])
  @@index([companyId, itemId])
}

model CashSnapshot {
  id              String   @id @default(cuid())
  companyId       String
  snapshotDate    DateTime
  frequency       String   @default("daily") // 'daily', 'weekly', 'monthly'
  accountId       String?  // QuickBooks account ID
  accountName     String   // Bank account name
  accountNumber   String?  // Last 4 digits (optional)
  cashBalance     Float
  changeAmount    Float?   // Change from previous period
  changePercent   Float?   // % change from previous period
  createdAt       DateTime @default(now())
  
  @@index([companyId, snapshotDate(sort: Desc)])
  @@index([companyId, frequency, snapshotDate(sort: Desc)])
  @@index([companyId, accountId])
}