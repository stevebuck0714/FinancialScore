generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Consultant {
  id                    String              @id @default(cuid())
  userId                String              @unique
  type                  String?
  fullName              String
  address               String?
  phone                 String?
  revenueSharePercentage Float              @default(50.0) // Consultant's share of revenue (50% default)
  paymentMethod         String?             // check, ACH, wire, etc.
  taxId                 String?             // For 1099 reporting
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  companyAddress1       String?
  companyAddress2       String?
  companyCity           String?
  companyName           String?
  companyState          String?
  companyWebsite        String?
  companyZip            String?
  companies             Company[]
  revenueRecords        RevenueRecord[]
  payables              ConsultantPayable[]
  teamMembers           User[]              @relation("ConsultantTeamMembers")
  user                  User                @relation("PrimaryConsultant", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Company {
  id                         String                 @id @default(cuid())
  name                       String
  consultantId               String?                // Optional - NULL for standalone businesses
  // Tier 1 support routing: CONSULTANT or CORELYTICS
  tier1SupportOwner          String?                @default("CORELYTICS")
  // Consultant that owns Tier 1 support when owner is CONSULTANT
  tier1SupportConsultantId   String?
  // Optional per-company Tier 1 contact email override
  tier1SupportContactEmail   String?
  // Once true, operational APIs never serve mock data for this company.
  hasRealOperationalData     Boolean                @default(false)
  // When any real operational snapshot is first detected.
  realDataActivatedAt        DateTime?
  // Site-admin override to force demo/mock operational responses.
  forceOperationalMockData   Boolean                @default(false)
  addressStreet              String?
  addressCity                String?
  addressState               String?
  addressZip                 String?
  addressCountry             String?
  industrySector             Int?                   // Existing industry classification for benchmarks (keep as "Industry Group" in UI)
  accountingSystem           String?                // QuickBooks, Xero, NetSuite, Sage, etc.
  companySizeCategory        String?                // DEFAULT, SMB, MID_MARKET, ENTERPRISE
  industrySectorCategory     String?                // For specialized reporting (Agriculture, Mining, Construction, etc.)
  subscriptionMonthlyPrice   Float?
  subscriptionQuarterlyPrice Float?
  subscriptionAnnualPrice    Float?
  // One-time setup fee charged at onboarding (before recurring begins)
  subscriptionSetupFee       Float?                 @default(0)
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  selectedSubscriptionPlan   String?
  affiliateCode              String?
  affiliateId                String?
  subscriptionStatus         String?                @default("active") // 'active', 'paused', 'cancelled'
  subscriptionStartDate      DateTime?
  nextBillingDate            DateTime?
  lastBillingDate            DateTime?
  linesOfBusiness            Json?                  // Array of LOB objects: [{name: string, headcountPercentage: number}]
  headcountAllocations       Json?                  // Array of headcount allocation objects: [{lobName: string, percentage: number}]
  userDefinedAllocations     Json?                  // Array of user defined allocation templates: [{lobName: string, percentage: number}]
  accountMappings            AccountMapping[]
  accountingConnections      AccountingConnection[]
  apiSyncLogs                ApiSyncLog[]
  inforRawBatches            InforRawBatch[]
  inforRawRecords            InforRawRecord[]
  inforRawCompleteness       InforRawCompleteness[]
  assessmentRecords          AssessmentRecord[]
  revenueRecords             RevenueRecord[]
  subscriptionEvents         SubscriptionEvent[]
  affiliate                  Affiliate?             @relation(fields: [affiliateId], references: [id])
  consultant                 Consultant?            @relation(fields: [consultantId], references: [id], onDelete: SetNull)
  profile                    CompanyProfile?
  financialRecords           FinancialRecord[]
  subscription               Subscription?
  users                      User[]
  userAccess                 UserCompanyAccess[]
  documents                  CompanyDocument[]
  documentChunks             CompanyDocumentChunk[]
  loans                      Loan[]
  xeroTransactions           XeroTransaction[]
  financialForecastInputSettings FinancialForecastInputSettings?
  financialForecastBudgetArchives FinancialForecastBudgetArchive[]
  // expenseGoals              ExpenseGoal[]  // Doesn't exist in production DB
  // valuationSettings         ValuationSettings?  // Doesn't exist in production DB

  @@index([consultantId])
  @@index([affiliateId])
}

model FinancialForecastInputSettings {
  id                 String   @id @default(cuid())
  companyId          String   @unique
  revenueGrowthByRow Json
  cogsPctByRow       Json
  opexPctByRow       Json
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model FinancialForecastBudgetArchive {
  id        String   @id @default(cuid())
  companyId String
  label     String?
  snapshot  Json
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([createdAt])
}

model User {
  id                   String             @id @default(cuid())
  email                String             @unique
  passwordHash         String
  name                 String
  title                String?
  phone                String?
  role                 UserRole
  userType             UserType?
  companyId            String?
  consultantId         String?
  isPrimaryContact     Boolean            @default(false)
  companyRole          String?            @default("user") // 'user' or 'admin' - for company users only
  sidebarAccess        Json?              // Array of accessible sidebar sections
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  passwordResetExpires DateTime?
  passwordResetToken   String?            @unique
  backupCodes          String?
  mfaEnabled           Boolean            @default(false)
  mfaSecret            String?
  assessmentRecords    AssessmentRecord[]
  primaryConsultant    Consultant?        @relation("PrimaryConsultant")
  consultantFirm       Consultant?        @relation("ConsultantTeamMembers", fields: [consultantId], references: [id], onDelete: Cascade)
  financialRecords     FinancialRecord[]
  company              Company?           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyAccess        UserCompanyAccess[]
  trustedDevices       TrustedDevice[]
  uploadedDocuments    CompanyDocument[]  @relation("CompanyDocumentUploadedBy")

  @@index([email])
  @@index([companyId])
  @@index([consultantId])
  @@index([passwordResetToken])
}

model UserCompanyAccess {
  id          String   @id @default(cuid())
  userId      String
  companyId   String
  companyRole String?  @default("user")
  sidebarAccess Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
}

enum CompanyDocumentCategory {
  LOAN_DOCUMENTS
  FINANCING_DOCUMENTS
  LEGAL_AND_REGULATORY
  TAX_DOCUMENTS
  OTHER
}

model CompanyDocument {
  id               String                  @id @default(cuid())
  companyId        String
  uploadedByUserId String
  category         CompanyDocumentCategory

  originalFileName String
  blobUrl          String                  @unique
  blobPathname     String?                 @unique
  contentType      String?
  sizeBytes        Int?

  extractionStatus String                  @default("PENDING") // PENDING | DONE | FAILED | NO_TEXT
  extractedText    String?
  extractionError  String?

  // Chunk/embedding index status for document search (RAG).
  // PENDING | DONE | FAILED
  indexStatus      String                  @default("PENDING")
  indexedAt        DateTime?
  indexError       String?
  embeddingModel   String?
  embeddingDim     Int?

  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  company          Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploadedBy       User                    @relation("CompanyDocumentUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: Cascade)
  chunks           CompanyDocumentChunk[]

  @@index([companyId])
  @@index([uploadedByUserId])
  @@index([category])
  @@index([createdAt])
}

model CompanyDocumentChunk {
  id         String          @id @default(cuid())
  documentId String
  companyId  String

  chunkIndex Int
  startOffset Int?
  endOffset   Int?

  text       String
  textHash   String

  // Stored in Postgres as pgvector 'vector' type. Prisma does not natively support it,
  // but keeping the field here documents the column and allows raw SQL to reference it.
  embedding  Unsupported("vector")

  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  document   CompanyDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  company    Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@index([companyId])
}

model TrustedDevice {
  id                String   @id @default(cuid())
  userId            String
  deviceToken       String   @unique
  deviceName        String
  deviceFingerprint String?
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime @default(now())
  lastUsedAt        DateTime @default(now())
  expiresAt         DateTime
  isActive          Boolean  @default(true)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceToken])
  @@index([expiresAt])
  @@index([isActive])
}

model OpsSectorLayoutConfig {
  id             String   @id @default(cuid())
  sectorCategory String   @unique
  config         Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model FinancialRecord {
  id               String             @id @default(cuid())
  companyId        String
  uploadedByUserId String
  fileName         String
  fileUrl          String?
  rawData          Json
  columnMapping    Json
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  company          Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploadedBy       User               @relation(fields: [uploadedByUserId], references: [id])
  monthlyData      MonthlyFinancial[]

  @@index([companyId])
  @@index([uploadedByUserId])
}

model MonthlyFinancial {
  id                       String          @id @default(cuid())
  companyId                String
  financialRecordId        String
  monthDate                DateTime
  revenue                  Float           @default(0)
  revenueBreakdown         Json?           // LOB breakdown: { "LOB Name": amount, ... }
  expense                  Float           @default(0)
  expenseBreakdown         Json?           // LOB breakdown for total expenses
  cogsPayroll              Float           @default(0)
  cogsOwnerPay             Float           @default(0)
  cogsContractors          Float           @default(0)
  cogsMaterials            Float           @default(0)
  cogsCommissions          Float           @default(0)
  cogsOther                Float           @default(0)
  cogsTotal                Float           @default(0)
  cogsBreakdown            Json?           // LOB breakdown for total COGS
  payroll                  Float           @default(0)
  ownerBasePay             Float           @default(0)
  benefits                 Float           @default(0)
  insurance                Float           @default(0)
  professionalFees         Float           @default(0)
  subcontractors           Float           @default(0)
  rent                     Float           @default(0)
  taxLicense               Float           @default(0)
  // Income taxes (NOT operating expenses)
  stateIncomeTaxes         Float           @default(0)
  federalIncomeTaxes       Float           @default(0)
  phoneComm                Float           @default(0)
  infrastructure           Float           @default(0)
  autoTravel               Float           @default(0)
  salesExpense             Float           @default(0)
  marketing                Float           @default(0)
  trainingCert             Float           @default(0)
  mealsEntertainment       Float           @default(0)
  interestExpense          Float           @default(0)
  depreciationAmortization Float           @default(0)
  otherExpense             Float           @default(0)
  nonOperatingIncome       Float           @default(0)
  nonOperatingExpense      Float           @default(0)
  extraordinaryItems       Float           @default(0)
  lobBreakdowns            Json?           // Comprehensive LOB breakdowns for all fields
  cash                     Float           @default(0)
  ar                       Float           @default(0)
  inventory                Float           @default(0)
  otherCA                  Float           @default(0)
  tca                      Float           @default(0)
  fixedAssets              Float           @default(0)
  otherAssets              Float           @default(0)
  totalAssets              Float           @default(0)
  ap                       Float           @default(0)
  loc                      Float           @default(0)
  otherCL                  Float           @default(0)
  tcl                      Float           @default(0)
  ltd                      Float           @default(0)
  totalLiab                Float           @default(0)
  ownersCapital            Float           @default(0)
  ownersDraw               Float           @default(0)
  commonStock              Float           @default(0)
  preferredStock           Float           @default(0)
  retainedEarnings         Float           @default(0)
  additionalPaidInCapital  Float           @default(0)
  treasuryStock            Float           @default(0)
  totalEquity              Float           @default(0)
  totalLAndE               Float           @default(0)
  createdAt                DateTime        @default(now())
  financialRecord          FinancialRecord @relation(fields: [financialRecordId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([financialRecordId])
  @@index([monthDate])
}

model AssessmentRecord {
  id           String    @id @default(cuid())
  userId       String
  companyId    String
  responses    Json
  notes        Json
  isCompleted  Boolean   @default(false)
  overallScore Float?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
  @@index([isCompleted])
  @@index([completedAt])
}

model CompanyProfile {
  id             String   @id @default(cuid())
  companyId      String   @unique
  legalStructure String?
  businessStatus String?
  ownership      String?
  workforce      String?
  keyAdvisors    String?
  specialNotes   String?
  qoeNotes       String?
  disclosures    Json
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
  keyEmployees   Json?
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  userEmail  String
  action     String
  entityType String
  entityId   String?
  changes    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType])
  @@index([createdAt])
}

model IndustryBenchmark {
  id                String   @id @default(cuid())
  industryId        String
  industryName      String
  assetSizeCategory String
  metricName        String
  fiveYearValue     Float?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([industryId, assetSizeCategory, metricName])
  @@index([industryId])
  @@index([assetSizeCategory])
}

model AccountingConnection {
  id                 String             @id @default(cuid())
  companyId          String
  platform           AccountingPlatform
  status             ConnectionStatus   @default(INACTIVE)
  accessToken        String?
  refreshToken       String?
  tokenExpiresAt     DateTime?
  realmId            String?
  tenantId           String?
  organizationId     String?
  lastSyncAt         DateTime?
  autoSync           Boolean            @default(false)
  syncFrequency      String             @default("manual")
  platformVersion    String?
  connectionMetadata Json?
  errorMessage       String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  company            Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, platform])
  @@index([companyId])
  @@index([status])
  @@index([lastSyncAt])
}

model ApiSyncLog {
  id              String             @id @default(cuid())
  companyId       String
  platform        AccountingPlatform
  syncType        String
  status          String
  recordsImported Int                @default(0)
  errorCount      Int                @default(0)
  errorDetails    Json?
  duration        Int?
  createdAt       DateTime           @default(now())
  intuitTid       String?
  company         Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([platform])
  @@index([createdAt])
  @@index([companyId, platform, createdAt(sort: Desc)])
}

model InforSyncRun {
  id             String   @id
  companyId      String
  platform       String   @default("INFOR_M3")
  status         String   @default("running") // queued | running | done | failed | cancelled
  frequency      String   @default("daily")
  site           String?
  mode           String?
  backfillMonths Int?
  lookbackDays   Int?
  startDate      DateTime?
  endDate        DateTime?
  salesOnly      Boolean  @default(false)
  chunkCount     Int      @default(0)
  recordsCreated Int      @default(0)
  warningCount   Int      @default(0)
  retryCount     Int      @default(0)
  message        String?
  lastError      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  startedAt      DateTime @default(now())
  finishedAt     DateTime?
  lastChunkAt    DateTime?
  tasks          InforSyncTask[]

  @@index([companyId, status, createdAt(sort: Desc)])
  @@index([companyId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([status, updatedAt(sort: Desc)])
  @@index([companyId, platform, status, updatedAt(sort: Desc)])
}

model InforSyncTask {
  id            String                @id @default(cuid())
  runId         String
  companyId     String
  status        String                @default("pending") // pending | leased | done | failed | cancelled
  attemptCount  Int                   @default(0)
  maxAttempts   Int                   @default(6)
  availableAt   DateTime              @default(now())
  leaseOwner    String?
  leaseExpiresAt DateTime?
  payload       Json
  lastError     String?
  lastResponse  Json?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  startedAt     DateTime?
  finishedAt    DateTime?
  run           InforSyncRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  attempts      InforSyncTaskAttempt[]

  @@index([runId, status])
  @@index([runId, status, availableAt])
  @@index([runId, status, updatedAt(sort: Desc)])
  @@index([status, leaseExpiresAt])
  @@index([status, availableAt, leaseExpiresAt])
  @@index([status, availableAt, createdAt])
  @@index([companyId, status, availableAt])
  @@index([companyId, status, createdAt(sort: Desc)])
}

model InforSyncTaskAttempt {
  id              String        @id @default(cuid())
  taskId           String
  runId            String
  companyId        String
  attemptNo        Int
  status           String       // success | retry | failed | skipped
  httpStatus       Int?
  errorMessage     String?
  responseSnippet  String?
  recordsCreated   Int          @default(0)
  warningCount     Int          @default(0)
  durationMs       Int?
  startedAt        DateTime     @default(now())
  finishedAt       DateTime?
  task             InforSyncTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, attemptNo])
  @@index([runId, startedAt(sort: Desc)])
  @@index([companyId, startedAt(sort: Desc)])
}

model InforRawBatch {
  id          String   @id @default(cuid())
  companyId   String
  platform    String   @default("INFOR_M3")
  syncRunId   String?
  frequency   String?
  mode        String?
  windowStart DateTime?
  windowEnd   DateTime?
  businessDate DateTime?
  module      String?
  miProgram   String?
  transaction String?
  endpointPath String?
  pageNo      Int      @default(1)
  bookmarkIn  String?
  bookmarkOut String?
  recordCount Int      @default(0)
  httpStatus  Int?
  durationMs  Int?
  payloadHash String?
  status      String   @default("success") // success | retry | failed | skipped
  errorMessage String?
  fetchedAt   DateTime @default(now())
  createdAt   DateTime @default(now())
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  records     InforRawRecord[]

  @@unique([companyId, platform, syncRunId, module, miProgram, transaction, businessDate, pageNo, bookmarkIn])
  @@index([companyId, platform, fetchedAt(sort: Desc)])
  @@index([companyId, syncRunId, fetchedAt(sort: Desc)])
  @@index([companyId, businessDate, module, miProgram])
  @@index([status, fetchedAt(sort: Desc)])
}

model InforRawRecord {
  id               String   @id @default(cuid())
  batchId          String
  companyId        String
  platform         String   @default("INFOR_M3")
  syncRunId        String?
  businessDate     DateTime?
  module           String?
  miProgram        String?
  transaction      String?
  sourceRecordId   String?
  sourceRecordHash String?
  payload          Json
  fetchedAt        DateTime @default(now())
  createdAt        DateTime @default(now())
  batch            InforRawBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, platform, syncRunId, businessDate, miProgram, transaction, sourceRecordHash])
  @@index([batchId, createdAt(sort: Desc)])
  @@index([companyId, syncRunId, createdAt(sort: Desc)])
  @@index([companyId, businessDate, module, miProgram, createdAt(sort: Desc)])
}

model InforRawCompleteness {
  id            String   @id @default(cuid())
  companyId     String
  platform      String   @default("INFOR_M3")
  syncRunId     String?
  businessDate  DateTime
  sourceKey     String // cash | inventory | sales | ar | ap | daily_financial
  isComplete    Boolean  @default(false)
  lastBatchId   String?
  statusMessage String?
  lastSeenAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, platform, syncRunId, businessDate, sourceKey])
  @@index([companyId, businessDate, sourceKey])
  @@index([companyId, syncRunId, businessDate])
  @@index([isComplete, updatedAt(sort: Desc)])
}

model AccountMapping {
  id                      String   @id @default(cuid())
  companyId               String
  qbAccount               String
  qbAccountId             String?
  qbAccountCode           String?
  qbAccountClassification String?
  targetField             String
  allocationMethod        String   @default("manual")
  confidence              String   @default("medium")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  lobAllocations          Json?
  company                 Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, qbAccountId])
  @@index([companyId, qbAccount])
  @@index([companyId])
}

// Machine Learning: Stores learned patterns from account mappings across all companies
model LearnedMapping {
  id                      String   @id @default(cuid())
  accountName             String   // Normalized account name
  accountClassification   String?  // Asset, Liability, Revenue, Expense, etc.
  targetField             String   // Where this account should be mapped
  useCount                Int      @default(1) // How many times this mapping has been used
  lastUsedAt              DateTime @default(now())
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([accountName, accountClassification, targetField])
  @@index([accountName])
  @@index([targetField])
}

