  itemId       String?  // QuickBooks item ID
  itemName     String
  sku          String?
  warehouse    String?
  bin          String?
  lot          String?
  qtyOnHand    Float
  assetValue   Float
  avgCost      Float?
  createdAt    DateTime @default(now())
  
  @@index([companyId, snapshotDate(sort: Desc)])
  @@index([companyId, frequency, snapshotDate(sort: Desc)])
  @@index([companyId, itemId])
}

model CashSnapshot {
  id              String   @id @default(cuid())
