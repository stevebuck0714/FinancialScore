import { NextRequest, NextResponse } from 'next/server';
import { XeroClient } from 'xero-node';
import prisma from '@/lib/prisma';
import { decryptOAuthToken, encryptOAuthToken } from '@/lib/encryption';
import { parseXeroMonthlyData } from '@/lib/xero-parser';
import { CompanyLOB } from '@/lib/lob-allocator';
import { emitSyncStatus } from '@/lib/websocket-emit';

export const dynamic = 'force-dynamic';

export async function POST(request: NextRequest) {
  const syncStartTime = Date.now();
  let recordsImported = 0;
  let errorCount = 0;
  const errors: any[] = [];
  let companyId: string | undefined;

  try {
    const body = await request.json();
    companyId = body.companyId;
    const userId = body.userId;

    if (!companyId || !userId) {
      return NextResponse.json({ error: 'Company ID and User ID are required' }, { status: 400 });
    }

    // Emit sync started status
    emitSyncStatus(companyId, {
      status: 'started',
      message: 'Xero sync started',
      progress: 0,
    });

    // Get connection from database
    const connection = await prisma.accountingConnection.findUnique({
      where: {
        companyId_platform: {
          companyId,
          platform: 'XERO',
        },
      },
    });

    if (!connection || !connection.accessToken || !connection.refreshToken) {
      return NextResponse.json({ error: 'Xero not connected' }, { status: 400 });
    }

    // Decrypt tokens
    console.log('🔐 Decrypting Xero tokens...');
    let accessToken: string;
    let refreshToken: string;
    
    try {
      accessToken = decryptOAuthToken(connection.accessToken);
      refreshToken = decryptOAuthToken(connection.refreshToken);
      console.log('✅ Tokens decrypted successfully');
    } catch (decryptError) {
      console.error('❌ Token decryption failed:', decryptError);
      await prisma.accountingConnection.update({
        where: {
          companyId_platform: {
            companyId,
            platform: 'XERO',
          },
        },
        data: {
          status: 'ERROR',
          errorMessage: 'Token decryption failed - please reconnect',
        },
      });
      return NextResponse.json({ 
        error: 'Token decryption failed - please reconnect',
        needsReconnect: true 
      }, { status: 401 });
    }

    // Parse scopes from environment
    const scopes = process.env.XERO_SCOPES?.split(' ') || [
      'accounting.transactions.read',
      'accounting.reports.read',
      'accounting.contacts.read',
      'accounting.settings.read',
      'offline_access',
    ];

    // Initialize Xero client
    const xeroClient = new XeroClient({
      clientId: process.env.XERO_CLIENT_ID || '',
      clientSecret: process.env.XERO_CLIENT_SECRET || '',
      redirectUris: [process.env.XERO_REDIRECT_URI || 'http://localhost:3000/api/xero/callback'],
      scopes: scopes,
    });

    // Set token
    xeroClient.setTokenSet({
      access_token: accessToken,
      refresh_token: refreshToken,
      expires_in: 1800, // 30 minutes
      token_type: 'Bearer',
    });

    // Check if token needs refresh (Xero tokens expire in 30 minutes)
    const now = new Date();
    const bufferTime = 5 * 60 * 1000; // 5 minutes buffer
    
    console.log('⏰ Token expiration check:');
    console.log('  Current time:', now.toISOString());
    console.log('  Token expires at:', connection.tokenExpiresAt?.toISOString() || 'Not set');
    
    const shouldRefresh = connection.tokenExpiresAt && 
                         (connection.tokenExpiresAt.getTime() - now.getTime() < bufferTime);
    
    if (shouldRefresh) {
      console.log('🔄 Token expiring soon, refreshing...');
      try {
        const newTokenSet = await xeroClient.refreshToken();
        
        // Update tokens in database
        await prisma.accountingConnection.update({
          where: {
            companyId_platform: {
              companyId,
              platform: 'XERO',
            },
          },
          data: {
            accessToken: encryptOAuthToken(newTokenSet.access_token),
            refreshToken: encryptOAuthToken(newTokenSet.refresh_token),
            tokenExpiresAt: new Date(Date.now() + (newTokenSet.expires_in || 1800) * 1000),
            status: 'ACTIVE',
            errorMessage: null,
          },
        });

        console.log('✅ Token refreshed successfully');
      } catch (refreshError: any) {
        console.error('❌ Token refresh failed:', refreshError);
        await prisma.accountingConnection.update({
          where: {
            companyId_platform: {
              companyId,
              platform: 'XERO',
            },
          },
          data: {
            status: 'ERROR',
            errorMessage: 'Token refresh failed - please reconnect',
          },
        });
        return NextResponse.json({ 
          error: 'Token expired - please reconnect',
          needsReconnect: true 
        }, { status: 401 });
      }
    }

    const tenantId = connection.tenantId;
    if (!tenantId) {
      return NextResponse.json({ error: 'Xero Tenant ID not found' }, { status: 400 });
    }

    // Update sync progress
    emitSyncStatus(companyId, {
      status: 'in_progress',
      message: 'Fetching financial data from Xero...',
      progress: 10,
    });

    // Calculate date range - for Xero demo/dev accounts, fetch previous year's data
    // Demo accounts typically have data scattered throughout a calendar year
    // Xero API limit: maximum 11 periods per request
    const today = new Date();
    
    // If we're in January, fetch previous year
    // Otherwise fetch current year-to-date
    const currentMonth = today.getMonth(); // 0 = January
    const targetYear = currentMonth === 0 ? today.getFullYear() - 1 : today.getFullYear();
    
    // Fetch 11 months (Xero API limit) - Jan through Nov
    const overallStartDate = new Date(targetYear, 0, 1); // Jan 1
    const finalEndDate = new Date(targetYear, 10, 30); // Nov 30 (11 months: 0-10)

    console.log('📅 Fetching 11 months of data for Xero demo account:');
    console.log('  Year:', targetYear);
    console.log('  Start:', overallStartDate.toISOString().split('T')[0]);
    console.log('  End:', finalEndDate.toISOString().split('T')[0]);
    console.log('  (Fetching Jan-Nov to stay within Xero 11-period API limit)');

    // Fetch Chart of Accounts (for account mappings)
    emitSyncStatus(companyId, {
      status: 'in_progress',
      message: 'Fetching Chart of Accounts...',
      progress: 20,
    });

    console.log('📊 Fetching Chart of Accounts from Xero...');
    const accountsResponse = await xeroClient.accountingApi.getAccounts(tenantId);
    const xeroAccounts = accountsResponse.body.accounts || [];
    console.log(`📋 Found ${xeroAccounts.length} accounts in Chart of Accounts`);

    // Process accounts and create mappings
    emitSyncStatus(companyId, {
      status: 'in_progress',
      message: 'Processing account mappings...',
      progress: 30,
    });
    
    // Helper to normalize Xero account types to QuickBooks-style classifications
    function normalizeXeroAccountType(xeroType: string): string {
      const type = xeroType.toUpperCase();
      
      // Revenue types
      if (type === 'REVENUE' || type === 'SALES' || type === 'OTHERINCOME') {
        return 'Revenue';
      }
      
      // COGS - Xero uses DIRECTCOSTS for Cost of Goods Sold
      if (type === 'DIRECTCOSTS' || type === 'COSTOFGOODSSOLD') {
        return 'Cost of Goods Sold';
      }
      
      // Expense types (but not DIRECTCOSTS - that's COGS)
      if (type === 'EXPENSE' || type === 'OVERHEADS') {
        return 'Expense';
      }
      
      // Asset types
      if (type === 'BANK' || type === 'CURRENT' || type === 'FIXED' || 
          type === 'INVENTORY' || type === 'NONCURRENT' || type === 'PREPAYMENT' ||
          type === 'DEPRECIATN') {
        return 'Asset';
      }
      
      // Liability types
      if (type === 'CURRLIAB' || type === 'LIABILITY' || type === 'TERMLIAB' || 
          type === 'PAYGLIABILITY') {
        return 'Liability';
      }
      
      // Equity
      if (type === 'EQUITY') {
        return 'Equity';
      }
      
      // Default to Other
      return 'Other';
    }
    
    let mappingsCreated = 0;
    for (const account of xeroAccounts) {
      // Only map active accounts
      if (account.status !== 'ACTIVE') continue;
      
      const accountCode = account.code || '';
      const accountName = account.name || '';
      const xeroType = account.type || '';
      const normalizedType = normalizeXeroAccountType(xeroType);
      
      if (!accountName) continue;
      
      await prisma.accountMapping.upsert({
        where: {
          companyId_qbAccount: {
            companyId,
            qbAccount: accountName,
          },
        },
        create: {
          companyId,
          qbAccount: accountName,
          qbAccountCode: accountCode,
          qbAccountClassification: normalizedType,
          targetField: 'unmapped',
          confidence: 'medium',
        },
        update: {
          qbAccountCode: accountCode,
          qbAccountClassification: normalizedType,
        },
      });
      
      mappingsCreated++;
    }
    
    console.log(`✅ Created/updated ${mappingsCreated} account mappings`);

    // Get company LOBs
    const company = await prisma.company.findUnique({
      where: { id: companyId },
      select: { linesOfBusiness: true },
    });

    const lobs: CompanyLOB[] = company?.linesOfBusiness 
      ? (company.linesOfBusiness as any[]).map((lob: any) => ({
          name: lob.name,
          headcountPercentage: lob.headcountPercentage || 0,
        }))
      : [];

    // Fetch data for the last 11 months
    console.log('📅 Fetching financial data for last 11 months...');
    
    const allFinancialRecords: any[] = [];
    
    const startDateStr = overallStartDate.toISOString().split('T')[0];
    const endDateStr = finalEndDate.toISOString().split('T')[0];
    
    emitSyncStatus(companyId, {
      status: 'in_progress',
      message: `Fetching financial data from transactions...`,
      progress: 40,
    });
    
    try {
      // Load account mappings
      console.log(`  📋 Loading account mappings...`);
      const mappings = await prisma.accountMapping.findMany({
        where: { companyId },
      });
      console.log(`  ✅ Found ${mappings.length} account mappings`);
      
      const mappingLookup = new Map();
      mappings.forEach(m => {
        mappingLookup.set(m.qbAccount.toLowerCase(), m.targetField);
        if (m.qbAccountCode) {
          mappingLookup.set(m.qbAccountCode.toLowerCase(), m.targetField);
        }
      });
      
      console.log(`  🔄 Processing monthly reports...`);
      
      // Process each month individually with P&L and Balance Sheet reports
      const monthlyRecords = [];
      let currentDate = new Date(overallStartDate);
      
      // Loop through each month
      while (currentDate <= finalEndDate) {
        const date = new Date(inv.date);
        const monthKey = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`;
        
        if (!monthlyData.has(monthKey)) {
          const data = initMonthData();
          data.monthDate = new Date(date.getFullYear(), date.getMonth(), 1);
          monthlyData.set(monthKey, data);
        }
        
        const data = monthlyData.get(monthKey);
        
        // Process line items
        if (inv.lineItems && inv.lineItems.length > 0) {
          inv.lineItems.forEach((line: any) => {
            const amount = Math.abs(line.lineAmount || 0);
            const accountName = (line.accountName || '').toLowerCase();
            const accountCode = (line.accountCode || '').toLowerCase();
            const description = (line.description || '').toLowerCase();
            
            // Try to find mapping
            const targetField = mappingLookup.get(accountName) || 
                               mappingLookup.get(accountCode) || 
                               mappingLookup.get(description);
            
            if (targetField && targetField !== 'unmapped') {
              if (data.hasOwnProperty(targetField)) {
                data[targetField] += amount;
              }
            } else {
              // Fallback
              if (inv.type === 'ACCREC') data.revenue += amount;
              else if (inv.type === 'ACCPAY') data.expense += amount;
            }
          });
        } else {
          // No line items
          if (inv.type === 'ACCREC') data.revenue += inv.total || 0;
          else if (inv.type === 'ACCPAY') data.expense += inv.total || 0;
        }
      });
      
      // Process bank transactions
      bankTransactions.forEach((tx: any) => {
        const date = new Date(tx.date);
        const monthKey = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`;
        
        if (!monthlyData.has(monthKey)) {
          const data = initMonthData();
          data.monthDate = new Date(date.getFullYear(), date.getMonth(), 1);
          monthlyData.set(monthKey, data);
        }
        
        const data = monthlyData.get(monthKey);
        
        if (tx.lineItems && tx.lineItems.length > 0) {
          tx.lineItems.forEach((line: any) => {
            const amount = Math.abs(line.lineAmount || 0);
            const accountName = (line.accountName || '').toLowerCase();
            const accountCode = (line.accountCode || '').toLowerCase();
            const description = (line.description || '').toLowerCase();
            
            const targetField = mappingLookup.get(accountName) || 
                               mappingLookup.get(accountCode) || 
                               mappingLookup.get(description);
            
            if (targetField && targetField !== 'unmapped') {
              if (data.hasOwnProperty(targetField)) {
                data[targetField] += amount;
              }
            } else {
              if (tx.type === 'RECEIVE') data.revenue += amount;
              else if (tx.type === 'SPEND') data.expense += amount;
            }
          });
        } else {
          if (tx.type === 'RECEIVE') data.revenue += tx.total || 0;
          else if (tx.type === 'SPEND') data.expense += tx.total || 0;
        }
      });
      
      // Calculate totals
      monthlyData.forEach((data) => {
        data.cogsTotal = data.cogsPayroll + data.cogsOwnerPay + data.cogsContractors + 
                         data.cogsMaterials + data.cogsCommissions + data.cogsOther;
        
        data.expense = data.payroll + data.ownerBasePay + data.benefits + data.insurance +
                       data.professionalFees + data.subcontractors + data.rent + data.taxLicense +
                       data.phoneComm + data.infrastructure + data.autoTravel + data.salesExpense +
                       data.marketing + data.trainingCert + data.mealsEntertainment + 
                       data.interestExpense + data.depreciationAmortization + data.otherExpense;
      });
      
      // Calculate Balance Sheet from actual balances
      console.log(`  💰 Calculating Balance Sheet...`);
      const unpaidInvoices = invoices.filter((inv: any) => 
        inv.type === 'ACCREC' && inv.status !== 'PAID' && inv.status !== 'VOIDED'
      );
      const totalAR = unpaidInvoices.reduce((sum: number, inv: any) => sum + (inv.amountDue || 0), 0);
      
      const unpaidBills = invoices.filter((inv: any) => 
        inv.type === 'ACCPAY' && inv.status !== 'PAID' && inv.status !== 'VOIDED'
      );
      const totalAP = unpaidBills.reduce((sum: number, inv: any) => sum + (inv.amountDue || 0), 0);
      
      const cashIn = bankTransactions
        .filter((tx: any) => tx.type === 'RECEIVE')
        .reduce((sum: number, tx: any) => sum + Math.abs(tx.total || 0), 0);
      const cashOut = bankTransactions
        .filter((tx: any) => tx.type === 'SPEND')
        .reduce((sum: number, tx: any) => sum + Math.abs(tx.total || 0), 0);
      const totalCash = cashIn - cashOut;
      
      // Apply BS to all months
      monthlyData.forEach((data) => {
        data.cash = totalCash;
        data.ar = totalAR;
        data.ap = totalAP;
        data.tca = totalCash + totalAR;
        data.totalAssets = data.tca;
        data.tcl = totalAP;
        data.totalLiab = totalAP;
        data.totalEquity = data.totalAssets - data.totalLiab;
        data.totalLAndE = data.totalLiab + data.totalEquity;
      });
      
      const monthlyRecords = Array.from(monthlyData.values());
      
      // Debug: Log sample month data
      if (monthlyRecords.length > 0) {
        const sample = monthlyRecords[0];
        console.log('\n  📊 Sample month data (first month):');
        console.log(`    Month: ${sample.monthDate.toISOString().split('T')[0]}`);
        console.log(`    Revenue: $${(sample.revenue || 0).toFixed(2)}`);
        console.log(`    COGS Payroll: $${(sample.cogsPayroll || 0).toFixed(2)}`);
        console.log(`    COGS Total: $${(sample.cogsTotal || 0).toFixed(2)}`);
        console.log(`    Payroll: $${(sample.payroll || 0).toFixed(2)}`);
        console.log(`    Rent: $${(sample.rent || 0).toFixed(2)}`);
        console.log(`    Expense Total: $${(sample.expense || 0).toFixed(2)}`);
        console.log(`    Cash: $${(sample.cash || 0).toFixed(2)}`);
        console.log(`    AR: $${(sample.ar || 0).toFixed(2)}`);
        console.log(`    AP: $${(sample.ap || 0).toFixed(2)}`);
      }
      
      allFinancialRecords.push(...monthlyRecords);
      console.log(`  ✅ Built ${monthlyRecords.length} months from transactions`);
      
      if (monthlyRecords.length === 0) {
        console.warn(`  ⚠️  WARNING: No monthly records parsed. Check if data exists in Xero for this period.`);
        errors.push(`No data found for ${startDateStr} to ${endDateStr}`);
      }
      
    } catch (fetchError: any) {
      console.error(`❌ Error fetching financial data:`, fetchError);
      console.error(`   Error details:`, {
        message: fetchError.message,
        statusCode: fetchError.response?.statusCode,
        body: fetchError.response?.body,
      });
      errors.push(`Failed to fetch data: ${fetchError.message}`);
    }
    
    console.log(`\n✅ Total monthly records parsed: ${allFinancialRecords.length}`);
    
    if (errors.length > 0) {
      console.log(`\n⚠️  Errors encountered during sync:`);
      errors.forEach((err, idx) => console.log(`  ${idx + 1}. ${err}`));
    }
    
    // Now save all the data to database if we have records
    if (allFinancialRecords.length > 0) {
      console.log('\n💾 Saving financial data to database...');
      
      // Delete previous financial records for this company from Xero syncs
      await prisma.financialRecord.deleteMany({
        where: { 
          companyId,
          fileName: { contains: 'Xero Sync' }
        }
      });
      
      // Create the financial record with all monthly data
      const financialRecord = await prisma.financialRecord.create({
        data: {
          companyId,
          uploadedByUserId: userId,
          fileName: `Xero Sync - ${new Date().toISOString()}`,
          fileUrl: null,
          rawData: {
            syncDate: new Date().toISOString(),
            startDate: overallStartDate.toISOString().split('T')[0],
            endDate: finalEndDate.toISOString().split('T')[0],
            platform: 'XERO',
          },
          columnMapping: {}, // Xero doesn't need column mapping
          monthlyData: {
            create: allFinancialRecords.map((month) => ({
              companyId,
              monthDate: month.monthDate,
              // Income Statement - Revenue & COGS
              revenue: month.revenue || 0,
              cogsPayroll: month.cogsPayroll || 0,
              cogsOwnerPay: month.cogsOwnerPay || 0,
              cogsContractors: month.cogsContractors || 0,
              cogsMaterials: month.cogsMaterials || 0,
              cogsCommissions: month.cogsCommissions || 0,
              cogsOther: month.cogsOther || 0,
              cogsTotal: month.cogsTotal || 0,
              // Income Statement - Operating Expenses
              payroll: month.payroll || 0,
              ownerBasePay: month.ownerBasePay || 0,
              benefits: month.benefits || 0,
              insurance: month.insurance || 0,
              professionalFees: month.professionalFees || 0,
              subcontractors: month.subcontractors || 0,
              rent: month.rent || 0,
              taxLicense: month.taxLicense || 0,
              phoneComm: month.phoneComm || 0,
              infrastructure: month.infrastructure || 0,
              autoTravel: month.autoTravel || 0,
              salesExpense: month.salesExpense || 0,
              marketing: month.marketing || 0,
              trainingCert: month.trainingCert || 0,
              mealsEntertainment: month.mealsEntertainment || 0,
              interestExpense: month.interestExpense || 0,
              depreciationAmortization: month.depreciationAmortization || 0,
              otherExpense: month.otherExpense || 0,
              expense: month.expense || 0,
              // Balance Sheet
              cash: month.cash || 0,
              ar: month.ar || 0,
              inventory: month.inventory || 0,
              otherCA: month.otherCA || 0,
              tca: month.tca || 0,
              fixedAssets: month.fixedAssets || 0,
              otherAssets: month.otherAssets || 0,
              totalAssets: month.totalAssets || 0,
              ap: month.ap || 0,
              otherCL: month.otherCL || 0,
              tcl: month.tcl || 0,
              ltd: month.ltd || 0,
              totalLiab: month.totalLiab || 0,
              totalEquity: month.totalEquity || 0,
              totalLAndE: month.totalLAndE || 0,
            })),
          },
        },
        include: {
          monthlyData: true,
        },
      });
      
      recordsImported = financialRecord.monthlyData.length;
      console.log(`✅ Saved ${recordsImported} monthly records to database`);
    } else {
      recordsImported = 0;
      console.log('⚠️  No financial records to save');
    }

    // Fetch and store operational data
    console.log('\n🔄 Fetching operational data...');
    
    emitSyncStatus(companyId, {
      status: 'in_progress',
      message: 'Fetching cash balances...',
      progress: 92,
    });
    
    try {
      // Initialize Xero adapter for operational data
      const { XeroAdapter } = await import('@/lib/accounting-adapters/xero-adapter');
      const adapter = new XeroAdapter({
        companyId,
        connectionId: connection.id,
        accessToken: connection.accessToken,
        refreshToken: connection.refreshToken || undefined,
        tenantId: connection.tenantId || undefined,
      });
      
      // Fetch cash balances
      console.log('💰 Fetching cash balances...');
      const cashBalances = await adapter.getCashBalances();
      console.log(`✅ Found ${cashBalances.length} bank accounts`);
      
      // Fetch AR aging
      emitSyncStatus(companyId, {
        status: 'in_progress',
        message: 'Fetching AR aging...',
        progress: 94,
      });
      
      console.log('📊 Fetching AR aging report...');
      const arAging = await adapter.getARAgingReport();
      console.log(`✅ Found AR aging data for ${arAging.length} customers`);
      
      // Fetch AP aging
      emitSyncStatus(companyId, {
        status: 'in_progress',
        message: 'Fetching AP aging...',
        progress: 96,
      });
      
      console.log('📊 Fetching AP aging report...');
      const apAging = await adapter.getAPAgingReport();
      console.log(`✅ Found AP aging data for ${apAging.length} vendors`);
      
      // Fetch customer sales
      console.log('📊 Fetching customer sales...');
      const customerSales = await adapter.getCustomerSales();
      console.log(`✅ Found sales for ${customerSales.length} customers`);
      
      // Fetch product sales
      console.log('📊 Fetching product sales...');
      const productSales = await adapter.getProductSales();
      console.log(`✅ Found ${productSales.length} product sales`);
      
      // Fetch inventory (if available)
      console.log('📦 Fetching inventory...');
      const inventory = await adapter.getInventory();
      console.log(`✅ Found ${inventory.length} inventory items`);
      
      // Store operational data in database (get the most recent FinancialRecord)
      if (recordsImported > 0) {
        const latestFinancialRecord = await prisma.financialRecord.findFirst({
          where: { 
            companyId,
            fileName: { contains: 'Xero Sync' }
          },
          orderBy: { createdAt: 'desc' },
        });
        
        if (latestFinancialRecord) {
          // Store in the latest financial record's raw data (operational data)
          await prisma.financialRecord.update({
            where: { id: latestFinancialRecord.id },
            data: {
              rawData: {
                ...(latestFinancialRecord.rawData as any),
                operationalData: {
                  cashBalances,
                  arAging,
                  apAging,
                  customerSales,
                  productSales,
                  inventory,
                  lastSyncAt: new Date().toISOString(),
                },
              },
            },
          });
          
          console.log('✅ Operational data stored in financial record');
        }
      }
      
      console.log('✅ Operational data sync complete');
      
    } catch (operationalError: any) {
      console.error('⚠️  Error fetching operational data (non-critical):', operationalError.message);
      errors.push(`Operational data error (non-critical): ${operationalError.message}`);
      // Don't fail the entire sync for operational data errors
    }

    // Update connection status
    await prisma.accountingConnection.update({
      where: {
        companyId_platform: {
          companyId,
          platform: 'XERO',
        },
      },
      data: {
        lastSyncAt: new Date(),
        status: 'ACTIVE',
        errorMessage: null,
      },
    });

    // Log API sync
    await prisma.apiSyncLog.create({
      data: {
        companyId,
        platform: 'XERO',
        syncType: 'FULL',
        status: 'SUCCESS',
        recordsImported: recordsImported,
        errorCount: errors.length,
        duration: Date.now() - syncStartTime,
        errorDetails: errors.length > 0 ? {
          startDate: overallStartDate.toISOString().split('T')[0],
          endDate: finalEndDate.toISOString().split('T')[0],
          monthsProcessed: allFinancialRecords.length,
          errors: errors,
        } : undefined,
      },
    });

    // Emit completion status
    emitSyncStatus(companyId, {
      status: 'completed',
      message: `Successfully synced ${recordsImported} financial records`,
      progress: 100,
    });

    const syncDuration = Date.now() - syncStartTime;
    console.log('✅ Xero sync completed successfully');
    console.log(`⏱️  Duration: ${(syncDuration / 1000).toFixed(2)} seconds`);
    console.log(`📝 Records imported: ${recordsImported}`);

    return NextResponse.json({
      success: true,
      recordsImported,
      syncDuration,
      message: `Successfully imported ${recordsImported} financial records`,
    });

  } catch (error: any) {
    console.error('❌ Xero sync error:', error);
    
    // Log error
    try {
      await prisma.apiSyncLog.create({
        data: {
          companyId: companyId || 'unknown',
          platform: 'XERO',
          syncType: 'FULL',
          status: 'FAILED',
          recordsImported: recordsImported,
          errorCount: 1,
          duration: Date.now() - syncStartTime,
          errorDetails: { error: error.message || 'Unknown error', stack: error.stack },
        },
      });
    } catch (logError) {
      console.error('Failed to log sync error:', logError);
    }

    // Emit error status
    if (companyId) {
      emitSyncStatus(companyId, {
        status: 'error',
        message: error.message || 'Sync failed',
        progress: 0,
      });
    }

    return NextResponse.json(
      { 
        error: 'Sync failed',
        message: error.message,
        details: error.toString()
      },
      { status: 500 }
    );
  }
}


