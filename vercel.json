{
  "buildCommand": "npm run build",
  "installCommand": "npm install --include=dev",
  "functions": {
    "app/api/infor-m3/operational-transform-raw/route.ts": {
      "memory": 3008,
      "maxDuration": 300
    },
    "app/api/infor-m3/operational-transform-pending/route.ts": {
      "memory": 3008,
      "maxDuration": 300
    },
    "app/api/cron/process-infor-pending-transforms/route.ts": {
      "memory": 3008,
      "maxDuration": 300
    },
    "app/api/cron/sync-operational-data/route.ts": {
      "memory": 3008,
      "maxDuration": 300
    },
    "app/api/cron/sync-operational-system-integrations/route.ts": {
      "memory": 3008,
      "maxDuration": 300
    },
    "app/api/cron/process-company-documents/route.ts": {
      "memory": 3008,
      "maxDuration": 300
    },
    "app/api/cron/run-company-pulse/route.ts": {
      "memory": 3008,
      "maxDuration": 300
    },
    "app/api/cron/process-industry-brief-jobs/route.ts": {
      "memory": 3008,
      "maxDuration": 300
    },
    "app/api/cron/data-load-watchdog/route.ts": {
      "memory": 3008,
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/sync-operational-data",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/sync-operational-system-integrations",
      "schedule": "5 * * * *"
    },
    {
      "path": "/api/cron/process-infor-sync-runs",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/process-infor-pending-transforms",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/refresh-quickbooks-tokens",
      "schedule": "15 2 * * *"
    },
    {
      "path": "/api/cron/process-qbo-operational-backfill",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/process-company-documents",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/cleanup-devices",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/publish-financial-month",
      "schedule": "0 6 1 * *"
    },
    {
      "path": "/api/cron/run-company-pulse",
      "schedule": "30 10 * * *"
    },
    {
      "path": "/api/cron/process-industry-brief-jobs",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/data-load-watchdog",
      "schedule": "*/5 * * * *"
    }
  ]
}
