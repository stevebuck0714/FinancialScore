{
  "buildCommand": "npm run build",
  "installCommand": "npm install --include=dev",
  "crons": [
    {
      "path": "/api/cron/keepalive",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/sync-operational-data",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/cleanup-devices",
      "schedule": "0 3 * * *"
    }
  ]
}
